<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_keyboard_background"
    android:paddingBottom="16dp">

  <View
      android:id="@+id/line"
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/line_color"
      app:layout_constraintTop_toTopOf="parent" />

  <LinearLayout
      android:id="@+id/imeSearchBar"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_marginStart="8dp"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="8dp"
      android:background="@drawable/bg_ime_search_bar"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/line">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivImeSearchIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:srcCompat="@drawable/ic_search" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvImeSearchQuery"
        style="@style/KpaEditTextStyle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:clickable="false"
        android:gravity="center_vertical"
        android:hint="@string/ime_search_entry_hint"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:padding="0dp" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btImeSearchClear"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_ime_search_clear" />
  </LinearLayout>

  <FrameLayout
      android:id="@+id/imeCandidatesSlot"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="8dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/imeSearchBar">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContent"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/imeLockedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ime_search_bar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/ivImeLockedIcon"
          android:layout_width="18dp"
          android:layout_height="18dp"
          app:srcCompat="@drawable/ic_ime_lock" />

      <TextView
          android:id="@+id/tvImeLockedText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="@string/ime_database_locked_hint"
          android:textColor="@color/text_black_color"
          android:textSize="13sp" />

      <TextView
          android:id="@+id/btImeUnlock"
          android:layout_width="wrap_content"
          android:layout_height="28dp"
          android:background="@drawable/bg_ime_unlock_button"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:paddingStart="14dp"
          android:paddingEnd="14dp"
          android:singleLine="true"
          android:text="@string/ime_database_locked_unlock_button"
          android:textColor="@android:color/white"
          android:textSize="13sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_search" />
  </FrameLayout>

  <ImageView
      android:id="@+id/btAccount"
      style="@style/KpaImeKeyStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:src="@drawable/ic_ime_user"
      android:text="account"
      app:layout_constraintEnd_toStartOf="@+id/btPass"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/imeCandidatesSlot" />

  <TextView
      android:id="@+id/btPass"
      style="@style/KpaImeKeyStyle"
      android:layout_width="0dp"
      android:layout_height="40dp"
      android:gravity="center"
      android:src="@drawable/ic_ime_password"
      android:text="* * *"
      android:textColor="@color/color_4E85DB"
      app:layout_constraintBottom_toBottomOf="@+id/btAccount"
      app:layout_constraintEnd_toStartOf="@+id/btTotp"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toEndOf="@+id/btAccount"
      app:layout_constraintTop_toTopOf="@+id/btAccount" />

  <ImageView
      android:id="@+id/btTotp"
      style="@style/KpaImeKeyStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:src="@drawable/ic_totp"
      android:text="totp"
      android:visibility="visible"
      app:layout_constraintEnd_toStartOf="@+id/btOtherInfo"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toEndOf="@+id/btPass"
      app:layout_constraintTop_toTopOf="@+id/btAccount" />

  <ImageView
      android:id="@+id/btOtherInfo"
      style="@style/KpaImeKeyStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:src="@drawable/ic_ime_other_info"
      android:text="other"
      app:layout_constraintEnd_toStartOf="@+id/btChangeIme"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toEndOf="@+id/btTotp"
      app:layout_constraintTop_toTopOf="@+id/btAccount" />

  <ImageView
      android:id="@+id/btChangeIme"
      style="@style/KpaImeKeyStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:src="@drawable/ic_ime_keyboard"
      android:text="ime"
      app:layout_constraintEnd_toStartOf="@+id/btClose"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toEndOf="@+id/btOtherInfo"
      app:layout_constraintTop_toTopOf="@+id/btAccount" />

  <ImageView
      android:id="@+id/btClose"
      style="@style/KpaImeKeyStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:src="@drawable/ic_ime_close"
      android:text="close"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toEndOf="@+id/btChangeIme"
      app:layout_constraintTop_toTopOf="@+id/btAccount" />

  <LinearLayout
      android:id="@+id/llImeKeyboard"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="6dp"
      android:orientation="vertical"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/btAccount" />

</androidx.constraintlayout.widget.ConstraintLayout>
